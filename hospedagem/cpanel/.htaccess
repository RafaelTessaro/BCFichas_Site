# BC Fichas — configuração para hospedagem com cPanel/Apache (HostGator).
# Vai dentro do site.zip (python3 ferramentas/conferir.py --zip) e fica na pasta do subdomínio,
# junto com o index.html. Conferido num Apache 2.4 em 23/11/2026.

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  # "RewriteEngine On" aqui também impede que as regras do site da Balanças
  # (public_html/.htaccess) valham para esta pasta, se ela ficar dentro da public_html.
  RewriteEngine On

  # Sempre em https://bcfichas.balancass.com.
  # Só envie este arquivo depois de o cadeado (AutoSSL) estar ativo no subdomínio:
  # sem cadeado, o endereço redireciona para o https e não abre.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^bcfichas\.balancass\.com$ [NC]
  RewriteRule ^ https://bcfichas.balancass.com%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Compressão dos arquivos de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml application/manifest+json
</IfModule>

# Tempo que o navegador guarda cada tipo de arquivo.
# A página nunca fica guardada; CSS e JS, um dia (o "?v=" no index.html força a troca);
# fotos, um mês (mudou a foto: mude o nome ou o "?v="); letras, um ano.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeçalhos de segurança (os mesmos do vercel.json)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "(^\.ht|\.(log|md|ini|sh|txt\.bak)$)">
  Require all denied
</FilesMatch>
